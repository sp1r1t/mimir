# Mimir configuration. Copy to .env and adjust. Secrets belong only in .env (never committed).
# Feeds and interests are managed in the web UI and stored in the database, not here.

# --- Classification (TypeSafe Jev) -------------------------------------------
# API key from https://console.typesafe.ai. Leave empty to run without classification:
# articles are still collected and queued, and are classified automatically once a key
# is set and the container is restarted.
TYPESAFE_API_KEY=
# Model name or alias. Aliases (jev-latest) move with new releases; pin a versioned id
# (e.g. jev-1.14.0) for stable results. The versioned id that answered is stored either way.
JEV_MODEL=jev-latest
# Optional API base URL override.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Per-attempt request timeout (ms).
JEV_TIMEOUT_MS=30000
# Parallel classification requests.
CLASSIFY_CONCURRENCY=2
# Attempts per article before classification is marked failed (retryable from the Stats page).
CLASSIFY_MAX_ATTEMPTS=8
# Maximum characters of article text sent to the classifier.
CLASSIFY_MAX_CONTENT_CHARS=6000

# --- Stories ---------------------------------------------------------------------
# Articles are grouped into stories. Candidates come from full-text search; Jev (above)
# decides whether an article reports the same story and whether it is a meaningful update.
# Only stories with articles in this many days before the article are considered.
STORY_MATCH_WINDOW_DAYS=4
# Candidate stories per decision, and the minimum lexical similarity (0..1) to ask Jev at all.
# Lower finds more matches across differently worded headlines, at the cost of more Jev calls.
STORY_MAX_CANDIDATES=4
STORY_MIN_SIMILARITY=0.3

# --- Story Intelligence Briefs (MiniMax M Plan) ------------------------------------
# minimax, mock (offline test output), or none.
SUMMARY_PROVIDER=minimax
# An M Plan subscription key from the MiniMax console. Generation requests are only sent after
# the plan usage endpoint confirms that this key belongs to an active subscription, so a
# pay-as-you-go key is refused rather than billed. Also turn off automatic credit consumption
# in the MiniMax console: MiniMax otherwise uses credit packs once the plan allowance is spent.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3.1-Flash
# low, medium, high, xhigh or max. Higher reasons longer and uses more of the allowance.
MINIMAX_REASONING_EFFORT=low
MINIMAX_TIMEOUT_MS=180000
# Automatic summaries pause when either plan window (5 hours, weekly) falls to this remaining
# percentage, keeping the rest for summaries you request. All summaries pause at the minimum.
MINIMAX_AUTO_RESERVE_PERCENT=25
MINIMAX_MIN_REMAINING_PERCENT=3
# Optional endpoint overrides (international defaults shown).
# MINIMAX_BASE_URL=https://api.minimax.io
# MINIMAX_QUOTA_URL=https://www.minimax.io/v1/token_plan/remains
# Language of the summaries.
SUMMARY_LANGUAGE=English
# Automatic summaries: only for stories at or above this priority (0..1) whose latest
# development is recent. MAX_PER_DAY limits provider attempts (including retries) in a
# rolling 24-hour window. This is Mimir's cost limit, separate from MiniMax allowance.
# Manual requests bypass this local cap; provider allowance checks still apply.
SUMMARY_AUTO_ENABLED=true
SUMMARY_AUTO_MIN_PRIORITY=0.6
SUMMARY_AUTO_MAX_PER_DAY=40
SUMMARY_AUTO_MAX_AGE_HOURS=72
# An outdated summary of a high-priority story is regenerated at most this often (minutes).
SUMMARY_MIN_REGEN_MINUTES=120
# Parallel summary requests and attempts per request.
SUMMARY_CONCURRENCY=1
SUMMARY_MAX_ATTEMPTS=3
# Input budget per summary: articles and total characters of article text.
SUMMARY_MAX_ARTICLES=12
SUMMARY_MAX_INPUT_CHARS=40000
# Output token limit, including the model's reasoning.
SUMMARY_MAX_OUTPUT_TOKENS=16000

# --- Places and the map --------------------------------------------------------------
# The places a story is about are named in the same answer that writes the brief, so the
# articles are sent to the model once. Only names are asked for; the coordinates come from
# the OpenStreetMap gazetteer. Set PLACES_ENABLED=false to switch the feature off.
PLACES_ENABLED=true
# Input budget of the separate name-reading pass, used only for briefs written before the
# brief and the places came out of one answer: articles and total characters of article text.
PLACES_MAX_ARTICLES=12
PLACES_MAX_INPUT_CHARS=40000
# Output token limit, including the model's reasoning.
PLACES_MAX_OUTPUT_TOKENS=4000
# The OpenStreetMap gazetteer. Use a descriptive User-Agent: the public instance asks for one
# and serves at most one request a second per caller. Answers are cached in the database.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Mimir/0.1 (self-hosted news reader)
# Per-request timeout (ms) and the minimum gap between two requests (ms).
GEOCODER_TIMEOUT_MS=15000
GEOCODER_MIN_INTERVAL_MS=1000
# Map tiles. The default is the public OpenStreetMap raster tiles, which are meant for light
# use; point these at your own tile server if Mimir becomes busy. {z}, {x} and {y} are the
# zoom, column and row. The attribution is shown on the map and must credit the source.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Terms and the glossary ----------------------------------------------------------
# The terms a story uses that the reader may not know are named in the same answer that
# writes the brief, so the articles are sent to the model once. Each name is then looked
# up in Wikipedia; a term the encyclopedia does not know is explained from the articles
# instead. The explanations are kept in Mimir's own database and reused in every story.
# Set TERMS_ENABLED=false to switch the feature off.
TERMS_ENABLED=true
# Input budget of the separate name-reading pass, used only for briefs written before the
# brief and the terms came out of one answer: articles and total characters of article text.
TERMS_MAX_ARTICLES=12
TERMS_MAX_INPUT_CHARS=40000
# Output token limit, including the model's reasoning.
TERMS_MAX_OUTPUT_TOKENS=4000
# The encyclopedia. Use a descriptive User-Agent: Wikipedia asks for one and serves at
# most one request at a time per caller. Answers are cached in the database.
WIKIPEDIA_URL=https://en.wikipedia.org
WIKIPEDIA_USER_AGENT=Mimir/0.1 (self-hosted news reader)
# Per-request timeout (ms) and the minimum gap between two requests (ms).
WIKIPEDIA_TIMEOUT_MS=15000
WIKIPEDIA_MIN_INTERVAL_MS=1000

# --- Web interface -------------------------------------------------------------
# Host port binding used by docker-compose (default: localhost only).
MIMIR_PUBLISH=127.0.0.1:8470
# Optional HTTP basic auth for the UI and API, as user:password. Health endpoints stay open.
# MIMIR_BASIC_AUTH=me:change-this
LOG_LEVEL=info

# --- Feed collection --------------------------------------------------------------
# Default polling interval for new feeds, and the minimum allowed (minutes).
FEED_DEFAULT_POLL_MINUTES=30
FEED_MIN_POLL_MINUTES=5
# Upper bound for failure backoff (minutes).
FEED_MAX_BACKOFF_MINUTES=720
# Parallel feed fetches, timeout per request (ms), retries per fetch for transient errors.
FEED_CONCURRENCY=4
FEED_TIMEOUT_MS=20000
FEED_RETRIES=2
# Identify yourself to publishers.
HTTP_USER_AGENT=Mimir/0.1 (self-hosted news reader)
# Subscribe to the initial default feeds on first start.
MIMIR_SEED_DEFAULTS=true

# --- Full-text extraction ------------------------------------------------------------
# Fetch article pages when the feed carries less than EXTRACT_MIN_FEED_CHARS of text.
# robots.txt and noarchive directives are honoured; paywalls are not bypassed.
EXTRACT_ENABLED=true
EXTRACT_MIN_FEED_CHARS=1500
EXTRACT_CONCURRENCY=2
EXTRACT_TIMEOUT_MS=20000
EXTRACT_RESPECT_ROBOTS=true
# Block article URLs that resolve to private/LAN addresses (protects your network).
EXTRACT_ALLOW_PRIVATE_NETWORKS=false

# --- Housekeeping ----------------------------------------------------------------------
RETENTION_FETCH_LOG_DAYS=30
RETENTION_JOBS_DAYS=14
